config HW_STACK_PROTECTION
	default ARCH_HAS_STACK_PROTECTION

if BOARD_NRF9151DK_NRF9151 || BOARD_NRF9151DK_NRF9151_NS

config BOARD_NRF9151DK
	select USE_DT_CODE_PARTITION if BOARD_NRF9151DK_NRF9151_NS

config BT_HCI_VS
	default y if BT

config BT_WAIT_NOP
	default BT && $(dt_nodelabel_enabled,nrf5340_reset)

config I2C
	default $(dt_compat_on_bus,$(DT_COMPAT_NXP_PCAL6408A),i2c)

# Default to a minimal, bootloader-less TF-M so that generic Zephyr samples
# fit and boot without extra overlays: the minimal profile keeps the secure
# image small and BL2 is disabled to match the bootloader-less flash layout.
# Select a different TF-M profile (e.g. via the nordic-tfm-full snippet) and
# re-enable TFM_BL2 to build a full TF-M.
choice TFM_PROFILE_TYPE
	default TFM_PROFILE_TYPE_MINIMAL
endchoice

config TFM_BL2
	default n

endif # BOARD_NRF9151DK_NRF9151 || BOARD_NRF9151DK_NRF9151_NS
